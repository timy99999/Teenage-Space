PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key - server-side only, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by /admin/capacity (super_admin only) to compute usage percentages.
# Defaults match the Supabase Free tier - raise these after upgrading the plan.
DB_SIZE_LIMIT_MB=500
STORAGE_LIMIT_MB=1024

# Telegram agent "Барс" (bot/). Shared secret for /api/bot/*, must match BOT_API_SECRET
# in bot/.env. Generate with: openssl rand -base64 32
BOT_API_SECRET=
# Bot username from @BotFather, used to build the t.me deep link for account linking.
TELEGRAM_BOT_USERNAME=
# Gemini token prices for the "Барс" analytics cost estimate and the balance
# estimate. JSON map of model -> USD per 1,000,000 tokens. Unset => the Analytics
# tab shows tokens only and no cost. Keys must match the model names the bot reports
# (GEMINI_MODEL / GEMINI_ROUTER_MODEL / GEMINI_EMBED_MODEL in bot/.env; a leading
# "models/" is stripped). Current list prices (through 2026-12-31):
BARS_TOKEN_PRICES={"gemini-3.6-flash":{"input":0.75,"output":3.75},"gemini-3.5-flash-lite":{"input":0.30,"output":2.50},"gemini-embedding-001":{"input":0.15,"output":0}}

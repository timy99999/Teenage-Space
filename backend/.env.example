PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key - server-side only, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by /admin/capacity (super_admin only) to compute usage percentages.
# Defaults match the Supabase Free tier - raise these after upgrading the plan.
DB_SIZE_LIMIT_MB=500
STORAGE_LIMIT_MB=1024

# Telegram agent "Барс" (bot/). Shared secret for /api/bot/*, must match BOT_API_SECRET
# in bot/.env. Generate with: openssl rand -base64 32
BOT_API_SECRET=
# Bot username from @BotFather, used to build the t.me deep link for account linking.
TELEGRAM_BOT_USERNAME=
# Gemini token prices for the "Барс" analytics cost estimate. JSON map of
# model -> USD per 1,000,000 tokens. Unset => the Analytics tab shows tokens only
# and marks the cost as "not configured". Keys must match the model names the bot
# reports (see GEMINI_MODEL / GEMINI_ROUTER_MODEL in bot/.env).
# Example: {"gemini-3.6-flash":{"input":0.3,"output":2.5},"gemini-3.5-flash-lite":{"input":0.1,"output":0.4}}
BARS_TOKEN_PRICES=

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Backend base URL. Vite proxies /api to http://localhost:3000 in dev, so this can stay unset locally.
# VITE_API_URL=http://localhost:3000/api

# SEO / analytics — all optional, unset means "don't load". Get these from the
# respective consoles (Google Search Console + Analytics, Yandex Webmaster + Metrika).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_YANDEX_METRIKA_ID=12345678
# VITE_GOOGLE_SITE_VERIFICATION=verification-token-from-search-console
# VITE_YANDEX_VERIFICATION=verification-token-from-yandex-webmaster

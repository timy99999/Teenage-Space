# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any random string; Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Public https origin of THIS service. On Railway it defaults to RAILWAY_PUBLIC_DOMAIN,
# so it only needs setting for a custom domain or a tunnel.
WEBHOOK_BASE_URL=

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# Must match the vector(N) column in the bars_bot migration. Changing it means
# re-embedding the whole catalogue.
EMBED_DIM=768

# --- Teenage Space backend --------------------------------------------------
API_BASE_URL=http://localhost:3000/api
# Same value as BOT_API_SECRET in backend/.env
BOT_API_SECRET=
SITE_URL=http://localhost:5173

# --- Postgres (bot-owned tables + LangGraph checkpoints) --------------------
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the pooler (port 6543) host on Railway.
DATABASE_URL=

# --- Behaviour --------------------------------------------------------------
# How long Барс remembers a conversation, sliding from the last message.
MEMORY_TTL_HOURS=72
MAX_CONCURRENT_LLM=8
CATALOG_TTL_SECONDS=300
INDEX_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
